    from PIL import Image

    def extract_frame(gif_path, frame_number, output_path):
        with Image.open(gif_path) as im:
            try:
                im.seek(frame_number)
                im.save(output_path)
            except EOFError:
                print(f"Frame {frame_number} does not exist in the GIF.")

    # Example usage:
    extract_frame("animated.gif", 5, "frame_5.gif") # Extracts the 6th frame (0-indexed)



